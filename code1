<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Счётчик</title>
  <style>
    body { display: flex; justify-content: center; align-items: center; height: 100vh; font-family: sans-serif; }
    button { font-size: 2rem; padding: 1rem 2rem; border-radius: 12px; cursor: pointer; }
  </style>
</head>
<body>
  <button id="btn">Кликов: 0</button>
  <script>
    let count = 0;
    const btn = document.getElementById('btn');
    btn.addEventListener('click', () => {
      count++;
      btn.textContent = `Кликов: ${count}`;
    });
  </script>
</body>
</html>
